{
  "name": "athena",
  "module": "index.ts",
  "type": "module",
  "version": "1.0.0",
  "description": "Command Line utilities for personal knowledge gathering",
  "workspaces": [
    "plugins/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cacache": "^20.0.1",
    "@types/cors": "^2.8.19",
    "@types/he": "^1.2.3",
    "@types/html-to-text": "^9.0.4",
    "@types/imapflow": "^1.0.189",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/ms": "^2.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "bin": {
    "athena": "./cli.ts"
  },
  "scripts": {
    "docs:gen": "bun run scripts/generate-docs.ts",
    "dev": "bun run cli.ts",
    "serve": "bun run server.ts",
    "manifest:gen": "bun run scripts/generate-manifest.ts",
    "postinstall": "bun run manifest:gen",
    "build": "bun build --compile --compile-autoload-tsconfig --compile-autoload-package-json --minify-whitespace --minify-syntax --target bun --outfile dist/cli cli.ts"
  },
  "dependencies": {
    "@callumalpass/mdbase": "^0.2.2",
    "@logtape/file": "^2.0.7",
    "@logtape/logtape": "^2.0.7",
    "@logtape/pretty": "^2.0.7",
    "@trpc/server": "^11.17.0",
    "athena-plugin-calendar": "workspace:*",
    "athena-plugin-mail": "workspace:*",
    "athena-plugin-map": "workspace:*",
    "athena-plugin-morning": "workspace:*",
    "athena-plugin-tasks": "workspace:*",
    "athena-plugin-weather": "workspace:*",
    "cacache": "^20.0.4",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "fast-json-stable-stringify": "^2.1.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "he": "^1.2.0",
    "html-to-text": "^10.0.0",
    "i18next": "^26.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "imapflow": "^1.3.3",
    "js-yaml": "^4.1.1",
    "mailparser": "^3.9.8",
    "ms": "^2.1.3",
    "nanoid": "^5.1.11",
    "natural-orderby": "^5.0.0",
    "node-email-reply-parser": "^0.1.4",
    "tasknotes-nlp-core": "^0.1.5",
    "trpc-cli": "^0.14.1",
    "zod": "^4.4.3"
  }
}